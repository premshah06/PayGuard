# Kafka
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_TOPIC=transactions

# Generator
EVENTS_PER_SEC=10
GENERATOR_SEED=42

# PostgreSQL
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=payguard
POSTGRES_USER=payguard
POSTGRES_PASSWORD=payguard_secret
DATABASE_URL=postgresql://payguard:payguard_secret@localhost:5432/payguard

# Inference sidecar
INFERENCE_URL=http://localhost:8000
MODEL_PATH=ml/model.onnx
FEATURE_MAP_PATH=ml/feature_map.json

# API
API_KEY=dev-secret-key-change-in-production
API_PORT=8001

# Frontend (prefix VITE_ for Vite env exposure)
VITE_API_URL=http://localhost:8001
VITE_WS_URL=ws://localhost:8001/ws
VITE_API_KEY=dev-secret-key-change-in-production
